[Unit]
Description=Portfolio Flask Web Application
After=network.target

[Service]
User=root
WorkingDirectory=/opt/portfolio
EnvironmentFile=-/etc/environment
Environment="PORT=80"
ExecStart=/opt/portfolio/venv/bin/gunicorn -w 4 -b 0.0.0.0:80 app:app
Restart=always

[Install]
WantedBy=multi-user.target
